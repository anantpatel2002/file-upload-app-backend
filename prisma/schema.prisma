// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

model uploaded_file {
  id            String    @id @default(uuid())
  title         String
  originalname  String
  filename      String    @unique // The name of the file on disk
  path          String    @unique // The full path to the file
  mimetype      String
  size          Int
  uploadDate    DateTime  @default(now())
  extractedText String? // Nullable, as videos won't have this
  fileType      String    // "pdf" or "video"

  @@index([fileType])
  @@index([uploadDate])
}